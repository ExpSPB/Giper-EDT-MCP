# Eclipse IDE files
**/.project
**/.classpath
**/.settings/

# Build output from all modules
**/target/
**/bin/

# Do not reintroduce legacy Ditrix module trees
/mcp/bundles/com.ditrix.*/
/mcp/tests/com.ditrix.*/
/mcp/bundles/fm.giper.*/target
/mcp/tests/fm.giper.edt.*/target
/mcp/tests/fm.giper.edt.*/bin
nulq
nul
/source/*
!/source/compile.sh
log.log
.serena/
# Ignore personal/local .claude state, but SHARE project skills, hooks and settings
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
/mcp/repositories/fm.giper.edt.mcp.server.repository/target
/tests/e2e/__pycache__/
# grade.py now imports a sibling module, so this directory grows one too.
/tests/tool-choice/__pycache__/
/tests/e2e/*.xml
/.devtool
.mcp.json

# Proxy module build output
proxy/target/
tests/TestConfiguration/.scannerwork/

# Generated check-description copies (maven-resources-plugin from /checks)
/mcp/bundles/fm.giper.edt.mcp.server/checks/

# Scratch: EDT workspace .metadata dumps pulled in for diagnosis (logs, telemetry)
tmp/

# EDT builds the external-objects fixture into bin/ (an .epf build artifact, not a source)
/tests/ExternalObjects/bin/
